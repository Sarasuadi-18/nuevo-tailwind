                    </button>
               
                </div>
            </div>
            <div class="relative h-full ">
                <div class="flex items-cente justify-center lg:justify-end h-full">
                    <div class="bg-cover bg-center bg-no-repeat absolute z-10 w-64 h-64 sm:h-96 sm:w-96 lg:w-[448px] lg-h:[448px] animate-pulse" >
                        <img src="/src/assets/estrella.svg" alt="robots">
                    </div>
                    <div class="bg-cover bg-center w-full h-full inset-0 bg-no-repeat sm:w-[348px] sm:h-[348px]  lg:w-[448px] lg-h:[448px] relative z-20 aspect-square animate-bounce ">
