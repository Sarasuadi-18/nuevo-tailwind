    <div class="h-full lg:h-screen bg-[#101728] py-32 flex items-center justify-center">
        <section class="px-8 text-white max-w-7xl  mx-auto  grid lg:grid-cols-2 gap-24">
            <div class="space-y-14 flex flex-col items-center lg:items-start">
                <h1 class="font-extrabold text-6xl lg:text-7xl tracking-tighter text-center lg:text-start">
                    El asistente <span class="text-purple-600 ">Perfecto</span> para tu hogar
                </h1>
                <p class="text-xl lg:text-2xl font-medium tracking-tight text-center lg:text-start">
                    Lorem, ipsum dolor sit amet consectetur adipisicing elit. Cum consequuntur dignissimos minima vero necessitatibus
                    ipsum aspernatur
                    corrupti possimus soluta incidunt tempore quibusdam, quos pariatur doloribus deserunt architecto magni vel delectus.
                </p>
                
                
                <div class="flex items-center justify-center flex-wrap gap-6">
                        
                    <button type="button" class=" inline-flex items-center text-lg font-semibold p-0.5 overflow-hidden rounded-lg bg-linear-to-br from-pink-500 to-orange-400 hover:from-pink-600 hover:to-orange-500 cursor-pointer group " >
