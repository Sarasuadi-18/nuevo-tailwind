---
import "../styles/global.css";
import Navegacion from "../components/Navegacion.astro";
---

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi primer sitio web con tailwind</title>
    
</head>

<body >
    <Navegacion />
    
    <a href="/prueba-dos">prueba 2</a>
    <div class="container mx-auto mt-5">
        <h1 >Hola mundo con tailwind</h1>

        <h2 class="mt-5 text-green-500 text-5xl text-center"> Esto es un h2</h2>
        <h3 class="text-right">Esto es un h3</h3>
        <h3 class="uppercase">Esto es un h4</h3>
        <h3 class="w-48 rounded-lg bg-pink-400 text-white text-center py-10 px-5 m-10  text-xl">Esto es un h5</h3>
        <h3 class="shadow-md">Esto es un h5</h3>
   
        <button class="bg-blue-500  hover:bg-blue-700  text-white font-bold py-2 px-4 rounded">Mi botón</button>
        <div class="m-5  p-5  border">
            <p class="text-xl sm:text-xs text-right">Lorem ipsum dolor sit amet, consectetur adipisicing elit. Omnis qui aliquam, sequi id mollitia labore,
            quod molestias illo placeat, 
            quasi molestiae doloremque saepe dolorum cupiditate rerum dolor fuga voluptatibus perferendis!</p>
        </div>
    </div>

    <div class=" flex items-center justify-center  "> 
        <div class="max-w-sm rounded overflow-hidden shadow-lg">
            <img  class="w-full"  src="/src/assets/gato1.jpg" alt="gato">
            <div class="px-6 py-4">
                <div class="font-bold text-xl mb-2">Los gatos</div>
                <p>
                    Lorem ipsum dolor sit amet consectetur adipisicing elit. Itaque recusandae a dolorum tenetur hic sit eaque quas
                    voluptatum excepturi aspernatur? Vitae rerum provident numquam iure pariatur rem voluptates ipsa quos!
                </p>
            </div>

            <div class="px-6 py-4">
                <span class="inline-block bg-gray-200 rounded-full px-3 py1 text-sm font-semibold">#gato</span>
            </div>
        </div>
    </div>








    
    <footer>
        desarrollado por sarasuadi
    </footer>

</body>
</html>