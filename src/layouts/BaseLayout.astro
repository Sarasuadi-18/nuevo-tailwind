---
// src/layouts/BaseLayout.astro
import Header from '../components/Header.astro';
import '../styles/global.css';

const { title, bodyClass = "bg-white text-slate-900" } = Astro.props; 
// Por defecto el fondo será blanco, a menos que digas lo contrario
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body class={bodyClass}> <Header />
    <main>
      <slot />
    </main>
  </body>
</html>